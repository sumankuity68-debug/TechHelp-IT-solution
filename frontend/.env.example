# ═══════════════════════════════════════════════════════════════
# Frontend Environment Variables — CareerNest / TechHelp
# ═══════════════════════════════════════════════════════════════
# Copy to frontend/.env and fill in your real values.
# ⚠️  Variables must be prefixed with VITE_ to be exposed to the browser.
# ⚠️  NEVER commit the actual .env file with real credentials!
# ═══════════════════════════════════════════════════════════════

# ── Google OAuth ─────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Backend API URL (used by Vite proxy in development) ──────────
# In production, update this to your deployed backend URL
VITE_API_URL=http://localhost:5000
